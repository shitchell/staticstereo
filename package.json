{
  "name": "staticstereo",
  "version": "0.0.0",
  "description": "Static on the Stereo \u2014 animated autostereogram generator",
  "type": "module",
  "license": "WTFPL",
  "bin": {
    "stst": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./node": "./dist/node/index.js",
    "./web": "./dist/web/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:site": "vite build --config vite.site.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1",
    "gifenc": "^1",
    "omggif": "^1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vite": "^5.4.21",
    "vitest": "^2"
  }
}
